# 复制为 deploy.local.env（已 gitignore，勿提交）
# cp deploy.local.env.example deploy.local.env

DEPLOY_HOST=your-server-ip
DEPLOY_USER=ubuntu
DEPLOY_PORT=22
DEPLOY_PASSWORD=your-password-here
DEPLOY_HOSTKEY=ssh-ed25519 255 SHA256:your-fingerprint-here
DEPLOY_REMOTE_DIR=/opt/jxapp/server/zone-server
DEPLOY_PM2_APP=gin-zone-server
DEPLOY_ECOSYSTEM_FILE=ecosystem.config.js
DEPLOY_TAR_NAME=gin-zone-server.tar.gz
# 真实生产 ini（gitignore，部署必打包）: deploy/pm2/env.production
DEPLOY_ENV_FILE=deploy/pm2/env.production
