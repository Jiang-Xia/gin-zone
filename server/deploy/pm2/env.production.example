# 复制为 env.production（已 gitignore，勿提交）
# cp deploy/pm2/env.production.example deploy/pm2/env.production
# 部署时打进 release 的 config/env.production，随 current 原子切换

[app]
env = prod
key = change-me
page_size = 10
wechat_app_id = wx-your-app-id
wechat_app_secret = your-secret
openai_app_key =
; current 下 public 为软链，指向部署根共享 uploads
public_path = public
public_key = your-sm2-public-key-hex
private_key = your-sm2-private-key-hex
; 博客 API 仍在主域 /x-blog（zone 子域未挂该路径）
blog_url = https://jiang-xia.top/x-blog/api/v1
; 主站必填；jiang-xia.top 仅旧路径兼容（线上小程序）
allowed_origins = https://zone.jiang-xia.top,https://jiang-xia.top,https://admin.jiang-xia.top
sensitive_auto_revoke = true

[server]
host =
port = 9600
reader_timeout = 60
write_timeout = 60

[database]
type = mysql
host = 127.0.0.1
port = 3306
user = jxzone
password = change-me
dbname = zone_db
charset = utf8mb4
max_idle = 2
max_conn = 10
table_prefix = z_

[docs]
host = zone.jiang-xia.top
base_path = /api/v1

[redis]
host = 127.0.0.1:6379

[log]
; 日志目录在 release 外，与 PM2 日志同级
log_file_path = ../logs
log_file_name = gin-zone.log
log_file_sql_name = gin-zone-sql.log
log_level = INFO
